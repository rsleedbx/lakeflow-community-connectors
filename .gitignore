# IDE
.idea/
.vscode/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Configs with secrets (be careful not to commit real credentials)
**/configs/*_config.json
!**/configs/example_config.json

# Credentials and secrets (all sources)
sources/*/*.env
sources/*/credentials.*
sources/*/secrets.*
sources/*/test_credentials.json
sources/**/manual_setup_test.sh
**/cockroachdb_cdc_*.env
*.env

# Credential JSON files (but allow templates)
sources/**/.env/cockroachdb_cdc_azure.json
sources/**/.env/cockroachdb_credentials.json
sources/**/.env/cockroachdb_pipelines.json
!sources/**/.env/*.template
!sources/**/.env/README.md

# Local cache directories (test data)
.cache/